# Settings for docker/compose.yaml and docker/compose.multi.yaml: copy to .env beside them.

# The original OMSI 2 folder (with Omsi.exe, maps and Vehicles in it), mounted read-only.
# On Windows e.g. E:/SteamLibrary/steamapps/common/OMSI 2
OMSI2_PATH=/path/to/OMSI 2

# The time zone, for a server whose clock follows the real time (real_time = 1)
TZ=Europe/Berlin

# Another image or a fixed version, e.g. ghcr.io/gtaepic/openomsi-server:0.1.1541
#OPENOMSI_IMAGE=ghcr.io/gtaepic/openomsi-server:latest

# compose.multi.yaml only: the web address the servers are put under (its DNS name pointing at
# this machine; Caddy gets the HTTPS certificate by itself). http://localhost tries it out on
# this machine without one: the servers are then at http://localhost/spandau and /grundorf.
OMSI_DOMAIN=omsi.example.com
# the servers' names start with this
SERVER_NAME=openOMSI
